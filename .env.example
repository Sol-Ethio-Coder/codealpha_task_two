# Rename this file to .env and fill in your own values

# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pulse-social?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pulse-social?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the server runs on
PORT=5000
